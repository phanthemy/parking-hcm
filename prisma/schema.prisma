generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("USER") // USER, BUSINESS, ADMIN
  avatar    String?
  createdAt DateTime @default(now())
  reviews   Review[]
}

model ParkingSpot {
  id           String           @id @default(cuid())
  name         String
  address      String
  description  String?
  lat          Float
  lng          Float
  type         String // PARKING_LOT, RESTAURANT, CAFE, SERVICE, OTHER
  carSlots     Int              @default(0)
  bikeSlots    Int              @default(0)
  pricePerHour Float
  openTime     String
  closeTime    String
  phone        String?
  website      String?
  isPremium    Boolean          @default(false)
  status       String           @default("ACTIVE") // ACTIVE, PENDING, HIDDEN
  ownerId      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  images       ParkingImage[]
  reviews      Review[]
  profile      BusinessProfile?
  fbPosts      FacebookPost[]
}

// ===== Facebook Group Crawler =====

model FacebookPost {
  id            String         @id @default(cuid())
  fbPostId      String         @unique       // ID bài viết trên FB (tránh trùng)
  groupUrl      String                       // Link nhóm FB
  content       String?                      // Nội dung bài viết
  authorName    String?                      // Tên người đăng
  postDate      DateTime?                    // Ngày đăng bài
  isComment     Boolean        @default(false) // true = từ comment, false = bài chính
  parentPostId  String?                      // Link tới bài gốc nếu là comment
  status        String         @default("pending") // pending/approved/rejected
  matchedSpotId String?                      // Spot đã match
  matchedSpot   ParkingSpot?   @relation(fields: [matchedSpotId], references: [id])
  images        FacebookImage[]
  createdAt     DateTime       @default(now())
}

model FacebookImage {
  id     String       @id @default(cuid())
  url    String                // Path local ảnh/video đã tải về
  type   String       @default("image") // image/video
  postId String
  post   FacebookPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model CrawlConfig {
  id        String    @id @default(cuid())
  groupUrl  String    @unique       // URL nhóm FB
  groupName String                  // Tên nhóm hiển thị
  isActive  Boolean   @default(true)
  lastCrawl DateTime?               // Lần crawl cuối
  createdAt DateTime  @default(now())
}

model ParkingImage {
  id            String      @id @default(cuid())
  url           String
  parkingSpotId String
  parkingSpot   ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
}

model Review {
  id            String      @id @default(cuid())
  rating        Int // 1-5
  comment       String?
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  parkingSpotId String
  parkingSpot   ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model BusinessProfile {
  id              String      @id @default(cuid())
  parkingSpotId   String      @unique
  parkingSpot     ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)
  menuDescription String?
  services        String?
  specialOffers   String?
}

// Biển cấm đậu/dừng xe — crowdsource từ tài xế
// Dữ liệu CHỈ MANG TÍNH THAM KHẢO, tài xế tự chịu trách nhiệm xác minh
model ParkingBan {
  id          String   @id @default(cuid())
  lat         Float    // Tọa độ trung tâm biển báo
  lng         Float
  radius      Int      @default(50) // Bán kính ảnh hưởng (mét)
  street      String   // Tên đường / địa chỉ gần nhất
  district    String?  // Quận
  
  // Khung giờ cấm (dạng "06:00-09:00,16:00-19:00")
  banTimeRanges String  
  // Loại cấm: NO_PARKING (cấm đậu), NO_STOPPING (cấm dừng), TIME_LIMITED (giới hạn thời gian)
  banType     String   @default("NO_PARKING")
  // Ngày áp dụng: ALL (tất cả), WEEKDAY (thứ 2-6), WEEKEND (T7-CN)
  banDays     String   @default("ALL")
  
  note        String?  // Ghi chú thêm từ người báo
  imageUrl    String?  // Ảnh chụp biển báo thực tế
  
  // Workflow: PENDING → VERIFIED (admin duyệt) | REJECTED
  status      String   @default("PENDING")
  reportCount Int      @default(1) // Số người xác nhận thấy biển này
  
  reporterId  String?  // User báo cáo (optional, có thể ẩn danh)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
